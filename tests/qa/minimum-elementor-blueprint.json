{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Aomark Listings minimum Elementor QA",
    "description": "Disposable WordPress 6.0, PHP 7.4, and Elementor 3.5.0 compatibility environment.",
    "author": "aomark"
  },
  "preferredVersions": {
    "php": "7.4",
    "wp": "6.0"
  },
  "landingPage": "/aomark-listings-qa/",
  "login": true,
  "siteOptions": {
    "blogname": "Aomark Listings Minimum Elementor QA",
    "blogdescription": "Disposable declared Elementor floor fixture"
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEBUG": true,
        "WP_DEBUG_LOG": true,
        "WP_DEBUG_DISPLAY": false,
        "SCRIPT_DEBUG": true,
        "WP_DISABLE_FATAL_ERROR_HANDLER": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://downloads.wordpress.org/plugin/elementor.3.5.0.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "/wordpress/wp-content/plugins/aomark-listings/aomark-listings.php"
    },
    {
      "step": "runPHP",
      "code": "<?php define( 'AOMARK_LISTINGS_QA_EXPECT_ELEMENTOR', true ); define( 'AOMARK_LISTINGS_QA_EXPECT_WOOCOMMERCE', false ); require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/plugins/aomark-listings/tests/qa/fixture.php';"
    }
  ]
}
