{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Aomark Listings exact-ZIP Plugin Check",
    "description": "Disposable isolated Plugin Check environment for the exact Aomark Listings release ZIP.",
    "author": "aomark"
  },
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "landingPage": "/wp-admin/admin.php?page=plugin-check",
  "login": true,
  "siteOptions": {
    "blogname": "Aomark Listings Plugin Check QA",
    "blogdescription": "Disposable exact-package source compliance environment"
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEBUG": true,
        "WP_DEBUG_LOG": true,
        "WP_DEBUG_DISPLAY": false,
        "SCRIPT_DEBUG": true,
        "WP_DISABLE_FATAL_ERROR_HANDLER": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "plugin-check"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "vfs",
        "path": "/tmp/aomark-dist/aomark-listings.zip"
      },
      "options": {
        "activate": false,
        "targetFolderName": "aomark-listings",
        "onError": "throw"
      }
    }
  ]
}
